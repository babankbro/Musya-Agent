# PostgreSQL (same as ChatV1)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat-aio
DB_USER=postgres
DB_PASSWORD=1234

# MinIO (same as ChatV1)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_USE_SSL=false

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# pgvector (PostgreSQL-native vector search)
# Embeddings via Google Gemini API — no local model download needed
PGVECTOR_COLLECTION=musya_documents
EMBEDDING_MODEL=models/gemini-embedding-001

# Document Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md
AUTO_INGEST_ON_UPLOAD=true
ALLOW_EXTERNAL_URL_IMPORT=true
EXTERNAL_URL_TIMEOUT=30

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
